rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'admin@nagarsathi.app',
          'freefuzxcoj2@gmail.com',
          'sohail@nagarsathi.app'
        ];
    }

    function isActiveStaffManager() {
      return isVerifiedSuperAdmin() ||
        (request.auth != null &&
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'staff' &&
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true &&
          (
            get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.admin == true ||
            get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.accountType == 'ward_creator'
          ));
    }

    // Each citizen may read and update only their own profile.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'citizen';
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'citizen';
      allow delete: if false;
    }

    match /staff/{staffId} {
      allow get: if request.auth != null
        && resource != null
        && resource.data.role == 'staff'
        && resource.data.active == true
        && (request.auth.uid == staffId
          || ('phone_number' in request.auth.token
            && resource.data.phone == request.auth.token.phone_number));
      allow list: if request.auth != null
        && 'phone_number' in request.auth.token
        && resource.data.phone == request.auth.token.phone_number
        && resource.data.role == 'staff'
        && resource.data.active == true;
      allow update: if isActiveStaffManager()
        || (request.auth != null
          && request.auth.uid == staffId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['mustChangePassword']));
      allow create, delete: if isActiveStaffManager();
    }

    match /ward_officers/{officerId} {
      allow read: if isActiveStaffManager()
        || (request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email is string
          && resource.data.emailLower == request.auth.token.email.lower());
      allow update: if isActiveStaffManager()
        || (request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email is string
          && resource.data.emailLower == request.auth.token.email.lower()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['mustChangePassword', 'tempPassword']));
      allow create, delete: if isActiveStaffManager();
    }

    match /officer_audit_logs/{logId} {
      allow read, write: if isActiveStaffManager();
    }

    match /notifications/{notificationId} {
      allow read, write: if isActiveStaffManager();
    }
  }
}
